# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin session (dùng để ký cookie JWT cho phiên đăng nhập admin)
# Tạo bằng: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Worker phone OTP via an approved ZBS Template Message template.
CANDIDATE_OTP_SECRET=
ZALO_ZBS_ACCESS_TOKEN=
ZALO_CANDIDATE_OTP_TEMPLATE_ID=

# Connection string Postgres — chỉ dùng để chạy migration, app không đọc biến này.
# Project Settings → Database → Connection string → URI
DATABASE_URL=

# Cloudinary (upload logo công ty) — lấy tại Dashboard sau khi đăng nhập cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Analytics 4 — Measurement ID dạng G-XXXXXXXXXX.
# Lấy tại analytics.google.com → Admin → Data Streams → chọn stream web.
# Bỏ trống thì GA không được nhúng (dùng cho môi trường dev).
NEXT_PUBLIC_GA_ID=

# URL gốc của site, dùng cho sitemap.xml và robots.txt.
NEXT_PUBLIC_SITE_URL=https://vieclamcongnhan.com
